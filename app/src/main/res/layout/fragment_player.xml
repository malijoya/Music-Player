<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true"
    tools:context=".fragment.PlayerFragment">

    <!-- Ambient backdrop: the current artwork, heavily blurred, under a legibility scrim -->
    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/backdropScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_player_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/btnCollapse"
        style="@style/Widget.MusicPlayer.IconButton.Glass"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/close_player"
        android:src="@drawable/ic_expand_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/now_playing"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Overline"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@+id/btnCollapse"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnCollapse" />

    <ImageButton
        android:id="@+id/btnMore"
        style="@style/Widget.MusicPlayer.IconButton.Glass"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/more_options"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnCollapse" />

    <!-- Artwork -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvAlbumArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="@color/art_placeholder_bg"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tvSongTitle"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCollapse"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintWidth_max="@dimen/player_art_max"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/art_placeholder" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Track info -->
    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.MusicPlayer.PlayerTitle"
        app:layout_constraintBottom_toTopOf="@+id/tvArtist"
        app:layout_constraintEnd_toStartOf="@+id/btnFavorite"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Song Title" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.MusicPlayer.RowSubtitle"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/seekBar"
        app:layout_constraintEnd_toEndOf="@+id/tvSongTitle"
        app:layout_constraintStart_toStartOf="@+id/tvSongTitle"
        tools:text="Artist Name · Album" />

    <ImageButton
        android:id="@+id/btnFavorite"
        style="@style/Widget.MusicPlayer.IconButton.Glass"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/favorite"
        android:src="@drawable/ic_favorite_border"
        app:layout_constraintBottom_toBottomOf="@+id/tvArtist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSongTitle" />

    <!-- Progress -->
    <SeekBar
        android:id="@+id/seekBar"
        style="@style/Widget.MusicPlayer.SeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="14dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Caption"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@+id/btnPlayPause"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1:20" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Caption"
        android:textColor="@color/text_secondary"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="4:45" />

    <!-- Playback controls -->
    <ImageButton
        android:id="@+id/btnShuffle"
        style="@style/Widget.MusicPlayer.IconButton"
        android:contentDescription="@string/shuffle"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toStartOf="@+id/btnPrev"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause" />

    <ImageButton
        android:id="@+id/btnPrev"
        style="@style/Widget.MusicPlayer.IconButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/previous"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toStartOf="@+id/btnPlayPause"
        app:layout_constraintStart_toEndOf="@+id/btnShuffle"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnPlayPause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/play_pause"
        android:outlineSpotShadowColor="@color/accent_glow"
        android:src="@drawable/ic_play"
        android:stateListAnimator="@animator/press_scale"
        app:backgroundTint="@color/accent_fill"
        app:elevation="14dp"
        app:fabCustomSize="76dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSleepTimer"
        app:layout_constraintEnd_toStartOf="@+id/btnNext"
        app:layout_constraintStart_toEndOf="@+id/btnPrev"
        app:maxImageSize="34dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MusicPlayer.Circle"
        app:tint="@color/on_accent_color"
        tools:targetApi="p" />

    <ImageButton
        android:id="@+id/btnNext"
        style="@style/Widget.MusicPlayer.IconButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@string/next"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toStartOf="@+id/btnRepeat"
        app:layout_constraintStart_toEndOf="@+id/btnPlayPause"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause" />

    <ImageButton
        android:id="@+id/btnRepeat"
        style="@style/Widget.MusicPlayer.IconButton"
        android:contentDescription="@string/repeat"
        android:src="@drawable/ic_repeat"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnNext"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause" />

    <!-- Bottom row: sleep timer and queue -->
    <ImageButton
        android:id="@+id/btnSleepTimer"
        style="@style/Widget.MusicPlayer.IconButton.Glass"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/sleep_timer"
        android:src="@drawable/ic_timer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSleepTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Caption"
        android:textColor="@color/accent_color"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btnSleepTimer"
        app:layout_constraintStart_toEndOf="@+id/btnSleepTimer"
        app:layout_constraintTop_toTopOf="@+id/btnSleepTimer"
        tools:text="Stops in 12:30"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnQueue"
        style="@style/Widget.MusicPlayer.IconButton.Glass"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/queue"
        android:src="@drawable/ic_queue_music"
        app:layout_constraintBottom_toBottomOf="@+id/btnSleepTimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnSleepTimer" />

</androidx.constraintlayout.widget.ConstraintLayout>
